# ================================================================
# MAILMIND AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================

# 1. DATABASE CONFIGURATION (Required in Production)
# Use a hosted PostgreSQL database from Neon (neon.tech) or Supabase (supabase.com)
# Example: postgresql://neondb_owner:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. APPLICATION SECURITY
SECRET_KEY=mailmind-ai-secret-key-production-change-me
JWT_SECRET_KEY=mailmind-jwt-secret-key-production-change-me
ENVIRONMENT=production

# 3. AI / LLM ENGINE (Google Gemini API)
# Get a free key from: https://aistudio.google.com/apikey
# If left blank, MailMind automatically uses its built-in Scikit-Learn ML classifier & NLP rules.
LLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 4. GOOGLE OAUTH 2.0 (Gmail Integration)
# Create OAuth Credentials in Google Cloud Console with Gmail API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-deployment.vercel.app/api/auth/google/callback

# 5. URLS & CORS CONFIGURATION
FRONTEND_URL=https://your-deployment.vercel.app
BACKEND_URL=https://your-deployment.vercel.app
CORS_ORIGINS=https://your-deployment.vercel.app,http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# 6. FRONTEND ENVIRONMENT VARIABLE (Only if deploying frontend as a separate project)
# For unified deployment, leave empty (defaults to relative /api)
VITE_API_BASE_URL=

