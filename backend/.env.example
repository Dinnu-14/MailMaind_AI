# Copy to .env (never commit .env)
# Optional: leave empty to run in demo mode with the rule-based classifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SQLite by default (backend/data/app.db). For hosted persistence use PostgreSQL or a disk, e.g.
# DATABASE_URL=sqlite:////var/data/app.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex to also allow Vercel preview deployments
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
